{
    "name": "descom/aws-sns-notification",
    "description": "Package to Laravel to received notification from AWS SNS",
    "license": "MIT",
    "authors": [
        {
            "name": "Descom",
            "email": "soporte@descom.es",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-php-sns-message-validator": "^1.1",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "descom/dev": "^1.3",
        "friendsofphp/php-cs-fixer": "^3.75",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Descom\\AwsSnsNotification\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Descom\\AwsSnsNotification\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --stop-on-error --stop-on-failure"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Descom\\AwsSnsNotification\\AwsSnsNotificationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
